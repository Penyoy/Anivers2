rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidBookmark() {
      return request.resource.data.keys().hasAll(['animeId', 'title'])
        && request.resource.data.animeId is string && request.resource.data.animeId.size() > 0 && request.resource.data.animeId.size() < 300
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && (!('poster' in request.resource.data) || request.resource.data.poster is string)
        && (!('status' in request.resource.data) || request.resource.data.status is string)
        && (!('type' in request.resource.data) || request.resource.data.type is string);
    }

    function isValidHistory() {
      return request.resource.data.keys().hasAll(['animeId', 'episodeId'])
        && request.resource.data.animeId is string && request.resource.data.animeId.size() > 0
        && request.resource.data.episodeId is string && request.resource.data.episodeId.size() > 0
        && (!('position' in request.resource.data) || request.resource.data.position is number)
        && (!('duration' in request.resource.data) || request.resource.data.duration is number)
        && (!('completed' in request.resource.data) || request.resource.data.completed is bool);
    }

    function isValidProgress() {
      return request.resource.data.keys().hasAll(['animeId', 'episodeId'])
        && request.resource.data.animeId is string && request.resource.data.animeId.size() > 0
        && request.resource.data.episodeId is string && request.resource.data.episodeId.size() > 0
        && (!('position' in request.resource.data) || request.resource.data.position is number)
        && (!('duration' in request.resource.data) || request.resource.data.duration is number)
        && (!('completed' in request.resource.data) || request.resource.data.completed is bool);
    }

    // User profile doc
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Bookmarks subcollection
    match /users/{userId}/bookmarks/{animeId} {
      allow read, create, update, delete: if isOwner(userId);
      // optional tighter validation on create
      // allow create: if isOwner(userId) && isValidBookmark();
    }

    // History subcollection
    match /users/{userId}/history/{historyId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Watch progress subcollection
    match /users/{userId}/watchProgress/{episodeId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Legacy fallback for old single-doc array model (optional deny)
    // deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

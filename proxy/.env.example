# Copy to .env and fill with real values — NEVER commit .env
PORT=3000
UPSTREAM_API_URL=https://apps.animekita.org/api/v1.2.5
ALT_UPSTREAM_API_URL=https://users.animekita.org/api/v1.2.5
# If upstream requires secret/key (currently not required but ready)
UPSTREAM_API_KEY=
# Android app will only know this proxy URL, e.g. https://api.example.com
# Set in app/build.gradle.kts -> BuildConfig.API_BASE or via local.properties proxyUrl=
PROXY_BASE_URL=https://api.example.com
